# matthewrichter.dev environment variables (names and purposes only, never values).
# Pull real values with:  vercel env pull .env.local

# --- Supabase (project xvsgqxkvnuxgxnovyzfv, SHARED with betzgames; this app owns only the personal_* job-hunt tables (personal_bets belongs to betzgames))
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # lib/personal/db.ts; bypasses RLS

# --- /personal auth (Google sign-in, one allowed account; see lib/personal/auth.ts)
PERSONAL_PASSWORD=                    # seed for the personal_auth session cookie (HMAC); rotating it signs everyone out
GOOGLE_CLIENT_ID=                     # OAuth client for api/personal/auth/login + callback (NOT the Gmail sync, which is an Apps Script)
GOOGLE_CLIENT_SECRET=

# --- Scheduling auth
CRON_SECRET=                          # x-internal-secret expected by api/personal/job-scan and api/personal/gmail-sync;
                                      # pg_cron job "personal-job-scan" sends private_config.personal_cron_secret and the
                                      # Apps Script sends its SECRET property: both must equal this value

# NODE_ENV is set by Next.js; do not set it here.
