# matthewrichter.dev environment variables (names and purposes only, never values).
# Pull real values with:  vercel env pull .env.local

# --- Supabase (project xvsgqxkvnuxgxnovyzfv, SHARED with betzgames; this app owns only the personal_* tables)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # lib/personal/db.ts; bypasses RLS

# --- /personal auth
PERSONAL_PASSWORD=                    # single-user password gate for /personal
GOOGLE_CLIENT_ID=                     # Gmail OAuth for api/personal/gmail-sync
GOOGLE_CLIENT_SECRET=

# --- Scheduling auth
CRON_SECRET=                          # x-internal-secret expected by api/personal/job-scan;
                                      # pg_cron job "personal-job-scan" sends private_config.personal_cron_secret

# NODE_ENV is set by Next.js; do not set it here.
